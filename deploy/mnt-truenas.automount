[Unit]
Description=Automount TrueNAS NFS export for hug-face-rip backups
# Mounts on first access and re-mounts after an outage without operator action.
# Enable this unit (not the .mount) so boot never waits on the NAS.
# NOT supported inside LXC containers ("unit type not supported"): there,
# enable mnt-truenas.mount directly instead.

[Automount]
Where=/mnt/truenas

[Install]
WantedBy=multi-user.target
